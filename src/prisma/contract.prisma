// use prisma-8
model User {
  id        Int                        @id @default(autoincrement())
  email     String                     @unique
  username  String?
  name      String?
  posts     Post[]
  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()
}

model Post {
  id        Int                        @id @default(autoincrement())
  title     String
  content   String?
  author    User                       @relation(fields: [authorId], references: [id])
  authorId  Int
  imageID   Int?
  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()
}

enum GameType {
  @@type("pg/text@1")
  VideoGame = "VideoGame"
  BoardGame = "BoardGame"
}

model Game {
  id          Int      @id @default(autoincrement())
  title       String
  imageID     Int?
  type        GameType
  description String?
}

model Event {
  id          Int                        @id @default(autoincrement())
  title       String
  imageID     Int?
  description String?
  location    String?
  date        TimestamptzString          @default(now())
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()
}
